import streamlit as st
import google.generativeai as genai
from supabase import create_client, Client
import os
from dotenv import load_dotenv

# .env dosyasından gizli anahtarları yükle
load_dotenv()

st.set_page_config(page_title="AI Asistan - Pro SaaS", page_icon="🚀", layout="wide")

# Supabase ve API Key Bağlantısı (.env veya Streamlit secrets öncelikli)
SUPABASE_URL = os.getenv("SUPABASE_URL") or st.secrets.get("SUPABASE_URL", "")
SUPABASE_KEY = os.getenv("SUPABASE_KEY") or st.secrets.get("SUPABASE_KEY", "")
GEMINI_API_KEY = os.getenv("GEMINI_API_KEY") or st.secrets.get("GEMINI_API_KEY", "")

try:
    if SUPABASE_URL and SUPABASE_KEY:
        supabase: Client = create_client(SUPABASE_URL, SUPABASE_KEY)
    else:
        supabase = None
except Exception:
    supabase = None

st.title("🚀 AI Asistan - Ürün Sürümü (SaaS)")

st.sidebar.header("🔐 Kullanıcı Paneli")

if "user" not in st.session_state:
    st.session_state.user = None

if "credits" not in st.session_state:
    st.session_state.credits = 10

if not st.session_state.user:
    auth_mode = st.sidebar.radio("İşlem Seçin", ["Giriş Yap", "Kayıt Ol"])
    email = st.sidebar.text_input("E-posta")
    password = st.sidebar.text_input("Şifre", type="password")
    
    if st.sidebar.button("Onayla"):
        if supabase:
            try:
                if auth_mode == "Kayıt Ol":
                    response = supabase.auth.sign_up({"email": email, "password": password})
                    st.sidebar.success("Kayıt başarılı! Lütfen giriş yapın.")
                else:
                    response = supabase.auth.sign_in_with_password({"email": email, "password": password})
                    st.session_state.user = response.user
                    st.sidebar.success("Giriş başarılı!")
                    st.rerun()
            except Exception as e:
                st.sidebar.error(f"Hata: {e}")
        else:
            if email and password:
                st.session_state.user = {"email": email}
      st.sidebar.success("Test modunda giriş yapıldı!")
                st.rerun()
            else:
                st.sidebar.warning("Lütfen alanları doldurun.")
else:
    user_email = st.session_state.user.get('email', 'Kullanıcı') if isinstance(st.session_state.user, dict) else st.session_state.user.email
    st.sidebar.write(f"Hoş geldin, **{user_email}**")
    st.sidebar.metric(label="Kalan Kredi", value=st.session_state.credits)
    
    st.sidebar.divider()
    menu = st.sidebar.radio("Menü", ["🤖 Yapay Zeka Sohbet", "💳 Kredi Paketleri / Fiyatlandırma"])
    
    if st.sidebar.button("Çıkış Yap"):
        st.session_state.user = None
        st.rerun()

# Sayfa İçerikleri
if st.session_state.user:
    if menu == "🤖 Yapay Zeka Sohbet":
        if st.session_state.credits > 0:
            user_prompt = st.text_area("Yapay zekaya bir şeyler sorun...")
            
            if st.button("Gönder") and user_prompt:
                active_api_key = GEMINI_API_KEY
                if not active_api_key:
                    st.warning("Lütfen .env dosyasına GEMINI_API_KEY tanımlayın.")
                else:
                    try:
                        genai.configure(api_key=active_api_key)
                        model = genai.GenerativeModel("gemini-2.5-flash")
                        with st.spinner("Yapay zeka düşünüyor..."):
                            response = model.generate_content(user_prompt)
                            st.markdown("### Cevap:")
                            st.write(response.text)
                            
                            # Kredi düşürme
                            st.session_state.credits -= 1
                            st.rerun()
                    except Exception as e:
                        st.error(f"Bir hata oluştu: {e}")
        else:
            st.error("Krediniz bitti! Devam etmek için lütfen sol menüden 'Kredi Paketleri' kısmına gidip paket yükleyin.")
            
    elif menu == "💳 Kredi Paketleri / Fiyatlandırma":
        st.subheader("💎 Kredi Paketleri")
        st.write("Projeye devam etmek ve limitleri kaldırmak için dilediğin paketi seç!")
        
        col1, col2, col3 = st.columns(3)
        
        with col1:
            st.markdown("### 🥉 Başlangıç Paketi")
            st.markdown("**50 Kredi**")
            st.markdown("💰 **49 TL**")
            if st.button("Başlangıç Al"):
                st.session_state.credits += 50
                st.success("Tebrikler! 50 kredi hesabınıza eklendi.")
                st.rerun()
                
        with col2:
            st.markdown("### 🥈 Pro Paket (Popüler)")
            st.markdown("**200 Kredi**")
            st.markdown("💰 **149 TL**")
            if st.button("Pro Al"):
                st.session_state.credits += 200
                st.success("Tebrikler! 200 kredi hesabınıza eklendi.")
                st.rerun()
                
        with col3:
            st.markdown("### 🥇 Enterprise Paket")
            st.markdown("**1000 Kredi**")
            st.markdown("💰 **499 TL**")
            if st.button("Enterprise Al"):
                st.session_state.credits += 1000
                st.success("Tebrikler! 1000 kredi hesabınıza eklendi.")
                st.rerun()
else:
    st.info("Ürünü test etmek veya kullanmak için sol menüden giriş yapın.")